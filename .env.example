# ===== Server Monitor Production Configuration =====
# Copy this file to .env and fill in your values
# Required variables: DATABASE_PASSWORD, JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD, FRONTEND_URL

# Application
APP_NAME=Server Monitor

# === Database ===
# DATABASE_PASSWORD left as CHANGE_ME is auto-generated by install.sh
DATABASE_NAME=server-monitor
DATABASE_USER=server-monitor
DATABASE_PASSWORD=CHANGE_ME_RANDOM_PASSWORD

# === Security ===
# JWT_SECRET left as CHANGE_ME is auto-generated by install.sh
JWT_SECRET=CHANGE_ME_64_CHARS_RANDOM_STRING
JWT_EXPIRES_IN=24h

# === First Admin Account ===
# User is auto-created on first startup.
# ADMIN_PASSWORD left as CHANGE_ME is auto-generated and shown at the end of install.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# === Frontend URL ===
# Used in alert emails (no trailing slash)
# Examples:
#   Domain:  https://monitor.yourdomain.com
#   IP:      http://192.168.1.100:3006
FRONTEND_URL=https://monitor.yourdomain.com

# === Email Notifications (optional) ===
# Leave blank to disable email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@saasguard.io

# === Telegram Notifications (optional) ===
# Leave blank to disable Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Network Binding ===
# 127.0.0.1  = Nginx reverse proxy (recommended)
# 0.0.0.0    = Direct IP access
BIND_HOST=127.0.0.1

# Host ports. Use "auto" to let the installer pick the first free port
# (recommended for domain mode — ports are internal behind Nginx).
# In IP mode the frontend port is taken from FRONTEND_URL.
API_PORT=auto
DASH_PORT=auto

# === Container Memory Limits ===
# Hard caps per container. Lower on small VPS, raise if you see OOM restarts.
DB_MEM_LIMIT=512m
BACKEND_MEM_LIMIT=512m
FRONTEND_MEM_LIMIT=384m

# === Monitoring Tuning ===
# How often to collect metrics (milliseconds)
METRICS_INTERVAL_MS=3000

# Minimum time between duplicate alerts for same threshold (milliseconds)
ALERT_COOLDOWN_MS=300000

# === PM2 Integration (optional) ===
# install.sh AUTO-DETECTS this from the running PM2 daemon and overwrites the
# value below — you normally don't need to touch it.
# Only set manually if PM2 isn't running at install time. It must be the .pm2
# dir of the user that runs PM2 (e.g. /home/devops/.pm2, not /root/.pm2).
# The backend image ships pm2 7.x — the host pm2 major version must match.
PM2_HOME=/root/.pm2
